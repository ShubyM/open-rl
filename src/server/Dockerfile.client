# Use lightweight standard Python image (No CUDA or GPU drivers needed for client)
FROM python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    UV_FROZEN=1

# Install git, curl, and ca-certificates
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates && rm -rf /var/lib/apt/lists/*

# Install uv (blazing fast rust-based package manager)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

WORKDIR /app

# Copy only dependency inputs. Working-tree source is streamed into each Job.
COPY examples/pyproject.toml examples/uv.lock ./examples/

# Configure uv for Docker and caching
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Build the CPU-only recipe environment without installing local project code.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv --project examples sync --frozen --no-install-project

# The launcher overrides the command and runs uploaded source with this Python.
ENTRYPOINT ["/app/examples/.venv/bin/python"]
