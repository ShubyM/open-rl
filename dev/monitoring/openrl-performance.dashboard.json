{
  "displayName": "Open-RL: Accelerator Performance",
  "dashboardFilters": [
    {
      "labelKey": "resource.label.cluster_name",
      "filterType": "RESOURCE_LABEL"
    },
    {
      "labelKey": "resource.label.namespace_name",
      "filterType": "RESOURCE_LABEL",
      "stringValue": "default"
    }
  ],
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "yPos": 0,
        "xPos": 0,
        "width": 48,
        "height": 4,
        "widget": {
          "title": "",
          "text": {
            "content": "## Accelerator Duty Cycle\nRaw duty cycle metric from 0 to 100 representing how actively GPUs are processing. Compare 1-job vs multi-job runs to see how time-slicing improves utilization.",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 12,
        "height": 8,
        "widget": {
          "title": "Fleet mean GPU utilization (%)",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "avg(DCGM_FI_DEV_GPU_UTIL)"
            }
          }
        }
      },
      {
        "xPos": 12,
        "yPos": 8,
        "width": 12,
        "height": 8,
        "widget": {
          "title": "GPUs busy (>5% util)",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "count(DCGM_FI_DEV_GPU_UTIL > 5) or vector(0)"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 16,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "GPU utilization by node (%)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "avg by (Hostname) (DCGM_FI_DEV_GPU_UTIL)"
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 16,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "GPU memory used by node (MiB)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "avg by (Hostname) (DCGM_FI_DEV_FB_USED)"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
